{
  "manifest_version": 3,
  "name": "Feham — Urdu Reader",
  "version": "1.1.0",
  "description": "Hover over any Urdu word to see its English meaning, transliteration and dictionary entry.",
  "homepage_url": "https://github.com/tmnin/feham",

  "permissions": ["storage"],

  "host_permissions": ["https://translate.googleapis.com/*"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Feham — Urdu Reader"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["<all_urls>"]
    }
  ]
}
